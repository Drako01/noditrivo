{
  "name": "noditrivo",
  "displayName": "Noditrivo",
  "description": "Evidence-based change impact intelligence for VS Code",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "publisher": "armotusitio",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "activationEvents": [
    "onCommand:noditrivo.openControlCenter"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%noditrivo.untrusted.description%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "noditrivo.openControlCenter",
        "title": "%noditrivo.command.openControlCenter%"
      },
      {
        "command": "noditrivo.analyzeChanges",
        "title": "%noditrivo.command.analyzeChanges%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "noditrivo.openControlCenter"
        },
        {
          "command": "noditrivo.analyzeChanges"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && node --test test/*.test.cjs",
    "package": "npm run check && vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
